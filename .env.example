# Copy to .env.local for local development, and set these in your host
# (e.g. Cloudflare Pages → Settings → Environment variables) for production.
# Do not commit real values to a public repository.

# Canonical site origin, used for SEO (canonical URLs, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=

# Public contact address shown on the Contact page.
NEXT_PUBLIC_CONTACT_EMAIL=
